{
  "expo": {
    "name": "SquadFund",
    "slug": "squadfund-mobile",
    "scheme": "squadfund",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "ios": {
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "venmo",
          "cashapp"
        ]
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.squadfund.mobile"
    },
    "android": {
      "package": "com.squadfund.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    }
  }
}